{
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "description": "User name"
    },
    "email": {
      "type": ["string", "null"],
      "description": "Email address"
    },
    "age": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "banned"]
    }
  }
}
